{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dot-music",
  "version": "1.3.2",
  "identifier": "com.anshbhatt.dotmusic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5743",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DOT Music",
        "width": 800,
        "height": 600,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://www.youtube.com https://s.ytimg.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: https:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/player-bridge.html"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QjNGNUE3OTJGNEU0NjcKUldSbjVQU1NwL1d6MUFLSkhJaW5VUFlZakZGK0F5VCtLK3hqVjRCK0pFUUp2SDhPOFlIYlBvbU4K",
      "endpoints": [
        "https://github.com/ansh-logics/Dot-Play/releases/latest/download/latest.json"
      ]
    }
  }
}
