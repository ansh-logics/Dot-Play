{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "aux-windows",
  "description": "The menu bar popover and immersive screens: playback state, immersive controls and lyrics.",
  "windows": [
    "tray",
    "immersive-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-now-playing",
    "allow-tray-media-control",
    "allow-show-main-window",
    "allow-hide-tray-popover",
    "allow-open-immersive",
    "allow-close-immersive",
    "allow-set-immersive-idle",
    "allow-list-immersive-displays",
    "allow-set-immersive-screens",
    "allow-set-immersive-display",
    "allow-leave-immersive-to-player",
    "allow-get-lyrics",
    "allow-get-lyrics-candidates",
    "allow-lyrics-providers",
    "allow-romanize-lyrics",
    "allow-translate-lyrics"
  ]
}
