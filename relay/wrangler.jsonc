{
  // dot(.)music Phone Remote relay: serves the phone page and passes end-to-end encrypted
  // messages between a Mac and its paired phones. It never sees what's inside them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dot-music-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": false }
}
